{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "snapshot diario",
  "description": "Foto de un dia del radar: metadatos y noticias. Definicion en prosa: docs/contrato-de-datos.md",
  "type": "object",
  "required": [
    "version",
    "snapshot_date",
    "generated_at",
    "item_count",
    "items"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Version del contrato con la que se genero el snapshot."
    },
    "snapshot_date": {
      "type": "string",
      "description": "Dia que cubre el snapshot, en YYYY-MM-DD."
    },
    "generated_at": {
      "type": "string",
      "description": "Momento en que se cerro el snapshot, en UTC."
    },
    "item_count": {
      "type": "integer",
      "description": "Numero de entradas de items."
    },
    "items": {
      "type": "array",
      "description": "Noticias del dia, de la mas reciente a la mas antigua.",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "source", "published_at"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "source": { "type": "string" },
          "published_at": { "type": "string" },
          "summary": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" }
        }
      }
    }
  }
}
